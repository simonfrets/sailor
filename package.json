{
  "name": "sailor",
  "version": "0.1.0",
  "description": "A local, project-scoped workflow engine for orchestrating coding agents through CLI adapters.",
  "author": "Sinan Coskun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonfrets/sailor.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sailor": "./dist/cli/index.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.22.1",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:shell && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:shell": "bash scripts/check-shell-syntax.sh .",
    "prepare": "husky",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yaml,yml}": "prettier --write",
    "*.sh": "./scripts/check-shell-files.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "keywords": [
    "agents",
    "automation",
    "cli",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
